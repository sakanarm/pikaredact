# Copy to .env (never commit .env). Every LLM_<NAME>_BASE_URL becomes a connector in Settings.
# Any OpenAI-compatible endpoint works (vLLM, LiteLLM proxy, Ollama /v1 ...).
LLM_ONPREM_BASE_URL=https://llm.example.internal/v1
LLM_ONPREM_API_KEY=
LLM_ONPREM_MODEL=your-model-name

# LLM_CLOUD_BASE_URL=https://api.example.com/v1
# LLM_CLOUD_API_KEY=
# LLM_CLOUD_MODEL=another-model

LLM_DEFAULT_PROFILE=onprem
LLM_TIMEOUT=120
LLM_CONCURRENCY=4
LLM_VERIFY_TLS=true

MAX_UPLOAD_MB=50
JOB_TTL_SECONDS=3600
# PDF_THAI_FONT=/usr/share/fonts/truetype/noto/NotoSansThai-Regular.ttf

# ---- sign-in -------------------------------------------------------------
# AUTH_MODE=off turns sign-in off (one shared local admin). Anything else: sign-in required.
AUTH_MODE=on
# First admin, created once on start if missing. Change the password afterwards in "บัญชีของฉัน".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# AUTH_PASSWORD_LOGIN=0 hides username/password sign-in (Microsoft only).
AUTH_PASSWORD_LOGIN=1
SESSION_HOURS=12
# Always admin, cannot be demoted from the UI (comma-separated emails).
# PIKA_ADMIN_EMAILS=someone@example.com
# Public address of the app (behind a proxy); used for the Keycloak redirect URI and secure cookies.
# PUBLIC_URL=https://apps.example.com/PikaRedact

# Keycloak (OIDC, confidential client, standard flow). Leave empty to use username/password only.
# KEYCLOAK_ISSUER=https://sso.example.com/realms/<realm>
# KEYCLOAK_CLIENT_ID=pikaredact
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_IDP_HINT=entra
# KEYCLOAK_VERIFY_TLS=true
